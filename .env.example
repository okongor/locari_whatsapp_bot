# Copy to .env.local (Next.js) or set as Environment Variables in Vercel — never commit real values.

# WATI — from your Wati dashboard: More → API Docs
WATI_API_ENDPOINT=   # e.g. https://live-mt-server.wati.io/123456  (NO trailing slash)
WATI_ACCESS_TOKEN=   # paste exactly as shown, including "Bearer " if Wati includes it

# Firebase Admin — matches Locari's real firebaseAdmin.ts (3 separate vars, not a JSON blob)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Not used by the current WATI menu flow, kept for the optional AI fallback ---
DEEPSEEK_API_KEY=

# --- Meta Cloud API webhook (app/api/whatsapp/webhook) — only needed if you go back to Meta directly ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
