# Copy to .env.local (Next.js) or set as Environment Variables in Vercel — never commit real values.

# Meta WhatsApp Cloud API — primary provider (app/api/whatsapp/webhook)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Firebase Admin — matches Locari's real firebaseAdmin.ts (3 separate vars, not a JSON blob)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Not used by the current menu flow, kept for the optional free-text AI fallback ---
DEEPSEEK_API_KEY=
